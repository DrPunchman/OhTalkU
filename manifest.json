{
  "manifest_version": 3,
  "name": "OhTalkU",
  "version": "0.1.0",
  "description": "Speak English, post Japanese. Voice-to-text with an adjustable noise gate that translates to Japanese for live chats.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "offscreen", "storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.twitch.tv/*",
    "*://*.nicovideo.jp/*",
    "https://translate.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open OhTalkU" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.twitch.tv/*", "*://*.nicovideo.jp/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
